# Copy outside the checkout; absolute paths are on the customer Linux host.
# Replace every SET_ME. No pre-approved release images are supplied here.
APTRON_PROJECT_NAME=aptron-single-host
APTRON_BACKEND_IMAGE=SET_ME_REVIEWED_BACKEND_RUNTIME_AT_SHA256
APTRON_FRONTEND_IMAGE=SET_ME_REVIEWED_SAME_ORIGIN_FRONTEND_AT_SHA256
APTRON_POSTGRES_IMAGE=SET_ME_REVIEWED_POSTGRES17_AT_SHA256
APTRON_PGDATA=/srv/aptron/pgdata
APTRON_ENGINE_ENV_FILE=/srv/aptron/config/engine.env
APTRON_POSTGRES_PASSWORD_FILE=/srv/aptron/secrets/postgres-owner-password
APTRON_TLS_CERTIFICATE=/srv/aptron/secrets/tls.crt
APTRON_TLS_KEY=/srv/aptron/secrets/tls.key
APTRON_GATEWAY_CONFIG=/srv/aptron/config/nginx.conf
APTRON_BIND_ADDRESS=127.0.0.1
APTRON_HTTPS_PORT=8443
# Select an unused subnet; the exact gateway IP is the only trusted proxy.
APTRON_INGRESS_SUBNET=172.30.90.0/28
APTRON_GATEWAY_IP=172.30.90.2
