# Customer-owned file, mode 0600; never commit a filled copy.
# Runtime must be a restricted non-owner, non-superuser database identity.
# URL-encode the password. Provision privileges separately after migration.
DATABASE_URL=postgresql+psycopg://SET_ME_RUNTIME_USER:SET_ME_URLENCODED_PASSWORD@postgres:5432/aptron
CORS_ORIGINS=https://SET_ME_CUSTOMER_FQDN:8443
# Existing native/notification destination policies stay fail-closed by default.
OPSCONTROL_NOTIFICATION_ALLOWED_HOSTS=
OPSCONTROL_NOTIFICATION_ALLOWED_CIDRS=
OPSCONTROL_NATIVE_ALLOWED_HOSTS=
OPSCONTROL_NATIVE_ALLOWED_CIDRS=
OPSCONTROL_NATIVE_ALLOWED_PORTS=443
OPSCONTROL_NATIVE_ALLOW_HTTP=0
